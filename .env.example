# Copy to .env and put your own key in LLM_API_KEY.

# Language model, reached through an OpenAI-compatible API.
# Default: Cerebras, free tier, no local model to download. This is what the
# demonstration runs on: fast and without the stalls of other free tiers.
# Get a key at https://cloud.cerebras.ai
LLM_API_KEY=
LLM_MODEL=qwen-3.8-27b
LLM_BASE_URL=https://api.cerebras.ai/v1

# Other providers work by changing the three settings above, for example:
#   Groq         LLM_MODEL=llama-3.3-70b-versatile
#                LLM_BASE_URL=https://api.groq.com/openai/v1
#   local Ollama LLM_MODEL=qwen2.5:3b
#                LLM_BASE_URL=http://localhost:11434/v1
#                LLM_API_KEY=ollama
#                LLM_TIMEOUT=120
# The only requirement is tool-calling support: a model without it cannot drive
# the agents.

# Seconds to wait for one model call. The default of 6 fits a hosted free tier,
# where a stalled request is faster to abandon than to wait for. A local model
# answers in tens of seconds and never stalls, so raise this when you use one.
LLM_TIMEOUT=6

# The dataset is a snapshot: this date is used as "today".
TODAY=2026-08-05

# Password of every demo account, written into the database by load_data.py
# (change it before running that script).
DEMO_PASSWORD=arol2026

# Base URL encoded in the machine QR codes.
FRONTEND_URL=http://localhost:5173
